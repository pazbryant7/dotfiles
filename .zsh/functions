#!/usr/bin/env zsh

cache_dir="${ZDOTDIR:-$HOME/.zsh}/cache"

rez() {
  source "$HOME/.zshrc"
}

# Shell functions for binds
clear-and-redisplay() {
  printf '\033[2J\033[3J\033[H'
  zle redisplay
}

copy-terminal-buffer() {
  echo "$BUFFER" | xclip -selection clipboard
  zle reset-prompt
}

smart-help() {
  local cmd
  cmd="${BUFFER%% *}"
  if [ -z "$cmd" ] || [ -z "$BUFFER" ]; then
    return
  fi
  if man -w "$cmd" >/dev/null 2>&1; then
    BUFFER="man $cmd"
    zle accept-line
  elif command -v "$cmd" >/dev/null 2>&1; then
    BUFFER="$cmd --help | less -F"
    zle accept-line
  else
    printf '\a'
  fi
}

# Cache

cache_init() {
  local name=$1
  shift
  local file="$cache_dir/$name.zsh"
  [[ -d $cache_dir ]] || mkdir -p "$cache_dir"
  if [[ ! -s $file ]]; then
    "$@" >|"$file" || return
    zcompile "$file" 2>/dev/null
  fi
  source "$file"
}

# Completion
init_completion() {
  local dump="$cache_dir/zcompdump"
  [[ -d $cache_dir ]] || mkdir -p "$cache_dir"
  autoload -Uz compinit
  if [[ -s $dump ]]; then
    compinit -C -d "$dump"   # cache exists: trust it, skip security check, no regen
  else
    compinit -d "$dump"      # no cache: full init
    compile_dump
  fi
}

compile_dump() {
  local dump="$cache_dir/zcompdump"
  [[ -s $dump && (! -s $dump.zwc || $dump -nt $dump.zwc) ]] && zcompile "$dump"
}

compile_config() {
  local file
  for file in "$HOME/.zshrc" "$HOME/.zsh/aliases" "$HOME/.zsh/functions" "$HOME/.zsh/config"; do
    [[ -f $file && (! -f $file.zwc || $file -nt $file.zwc) ]] && zcompile "$file"
  done
}

# Clean
zclean() {
  local target_dir="${1:-$PWD}"
  if [[ ! -d "$target_dir" ]]; then
    echo "Directory not found: $target_dir" >&2
    return 1
  fi
  echo "Cleaning cache files in: $target_dir"
  if [[ -d "$target_dir/cache" ]]; then
    echo "Removing directory: $target_dir/cache"
    rm -rf "$target_dir/cache"
  fi
  local zwc_files=("$target_dir"/**/*.zwc(N))
  if ((${#zwc_files[@]} > 0)); then
    for f in "${zwc_files[@]}"; do
      echo "Removing file: $f"
      rm -f "$f"
    done
  else
    echo "No .zwc files found."
  fi
  echo "Done."
}
