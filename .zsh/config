#!/usr/bin/env zsh

autoload -Uz \
  url-quote-magic \
  edit-command-line

# Completions
zcompinit
zcompile-config &|

# Functions from ./functions
zle -N edit-command-line
zle -N smart-help
zle -N clear-and-redisplay
zle -N copy-terminal-buffer

# Custom binds
bindkey -e # use emacs preset
bindkey '\eh' smart-help
bindkey '^[e' edit-command-line
bindkey '^L' clear-and-redisplay
bindkey '^X' copy-terminal-buffer
bindkey '^[[Z' reverse-menu-complete

# Zsh options
setopt \
  AUTO_CD \

# Disable native zsh history file
export HISTFILE=/dev/null

# Completion configuration
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Nix shell indicator
if [[ -n "$IN_NIX_SHELL" ]]; then
  case "$IN_NIX_SHELL" in
    pure)   NIX_TAG="%F{green}[DEVELOP:pure]%f " ;;
    impure) NIX_TAG="%F{yellow}[DEVELOP:impure]%f " ;;
    *)      NIX_TAG="%F{green}[DEVELOP]%f " ;;
  esac
elif [[ -n "$IN_NX_SHELL" ]]; then
  NIX_TAG="%F{cyan}[NX:${NX_SHELL_PROFILE}]%f "
else
  NIX_TAG=""
fi

# White prompt
PROMPT="${NIX_TAG}%F{white}%2~%f "

# Cached tool inits
zsh-cache-init fzf fzf --zsh
zsh-cache-init atuin atuin init zsh

# Disable "c-s delay"
stty -ixon
stty susp undef
