#!/usr/bin/env sh

DOTS_DIR="$HOME/Documents/github/dotfiles"

create_dots_dir() {
  mkdir -p "$DOTS_DIR"
}

stow_dots() {
  case "${1:-}" in
  "") stow --dir="$DOTS_DIR" --target="$HOME" --restow . ;;
  --adopt) stow --dir="$DOTS_DIR" --target="$HOME" --adopt --restow . ;;
  *)
    printf 'Usage: dots [--adopt]\n' >&2
    return 1
    ;;
  esac
}

main() {
  create_dots_dir
  cd "$DOTS_DIR" || return 1
  stow_dots "$1"
  cd - || return 1
}

main "$@"
