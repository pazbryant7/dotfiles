#!/usr/bin/env sh

practice_dir="$HOME/Documents/github/temp/kata"
dirs="$HOME/Documents/github/leetcode
$practice_dir"

lower() {
  printf "%s" "$1" | tr '[:upper:]' '[:lower:]'
}

name() {
  lower "$(basename "$1")"
}

die() {
  printf "%s\n" "$1" >&2
  exit 1
}

in_tmux() {
  if [ -n "$TMUX" ]; then
    return 0
  else
    return 1
  fi
}

new_session() {
  "$HOME/bin/global/n" "$1"
}

new_window() {
  tmux new-window -t "$1" -c "$2"
}

get_index_type() {
  case "$1" in
  js)
    printf "index.ts"
    ;;
  py)
    printf "index.py"
    ;;
  cpp)
    printf "index.cpp"
    ;;
  rs)
    printf "index.rs"
    ;;
  go)
    printf "index.go"
    ;;
  *)
    die "unknown language: $1"
    ;;
  esac
}

ensure_dir() {
  if [ ! -d "$1" ]; then
    if ! mkdir -p "$1"; then
      die "cannot create directory: $1"
    fi
  fi
}

switch_to() {
  tmux switch-client -t "$1"
}

exist_session() {
  tmux has-session -t="$1" 2>/dev/null
}

setup() {
  dir="$1"
  lang="$2"

  sname=$(name "$dir")
  if [ -z "$sname" ]; then
    die "cannot derive name from: $dir"
  fi

  if exist_session "$sname"; then
    switch_to "$sname"
    return 0
  fi

  if ! new_session "$dir"; then
    die "cannot create session for: $dir"
  fi
}

workspace() {
  ensure_dir "$practice_dir"
  for dir in $dirs; do
    setup "$dir" "$1"
  done
}

main() {
  lang="${1:-js}"
  if in_tmux; then
    workspace "$lang"
  else
    printf "Not in a tmux session.\n" >&2
  fi
}

main "$@"
