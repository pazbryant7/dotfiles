#!/usr/bin/env sh

SESSION_DIRS="
$HOME/
$HOME/Documents/github
$HOME/Documents/github/temp
"

NOTES_PATH="$HOME/Documents/github/notes
$HOME/Documents/github/youtube
"

NOTES_FILE="todo.md"

get_name() {
  basename "$1" | tr . _ | tr '[:upper:]' '[:lower:]'
}

get_curr() {
  tmux display-message -p "#S"
}

exist() {
  tmux has-session -t "=$1" 2>/dev/null
}

is_notes_path() {
  printf '%s\n' "$NOTES_PATH" | rg -qFx "$1"
}

create() {
  tmux new-session -ds "$1" -c "$2"
}

switch_to() {
  tmux switch-client -t "$1"
}

notify() {
  tmux display-message "$1"
}

open_notes() {
  tmux send-keys -t "$1" "${EDITOR:-nvim} $2/$NOTES_FILE" Enter
}

pick_dirs() {
  # shellcheck disable=SC2086
  fd . --max-depth 1 --type d --type l --follow $SESSION_DIRS 2>/dev/null | fzf --multi
}

inside_of() {
  [ "$1" = "$(get_curr)" ]
}

verify() {
  path="$1"
  name="$2"

  if inside_of "$name"; then
    notify "Aleady inside of $2"
    return 1
  fi

  if ! exist "$name"; then
    create "$name" "$path"
  fi

  if is_notes_path "$path"; then
    open_notes "$name" "$path"
  fi

  return 0
}

single() {
  path="$1"
  name="${2:-$(get_name "$path")}"

  if verify "$path" "$name"; then
    switch_to "$name"
  fi
}

multi() {
  paths=$(pick_dirs)
  [ -z "$paths" ] && exit 1

  tmp=$(mktemp)
  printf '%s\n' "$paths" | while IFS= read -r path; do
    [ -z "$path" ] && continue
    name=$(get_name "$path")
    verify "$path" "$name"
    printf '%s' "$name" >"$tmp"
  done

  last=$(cat "$tmp")
  rm -f "$tmp"
  [ -n "$last" ] && switch_to "$last"
}

main() {
  [ -n "$1" ] && {
    single "$@"
    return
  }
  multi
}

main "$@"
