#!/usr/bin/env sh

DEFAULT_LAYOUT="bryantq"
DEFAULT_LAYOUT_INTL="bryantqi"
DEFAULT_DVORAK_LAYOUT="bryantd"
DEFAULT_DVORAK_LAYOUT_INTL="bryantdi"

get_current_layout() {
  setxkbmap -query | rg 'layout:' | awk '{print $2}'
}

send_notification() {
  display_name=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  notify-send "keyboard" "$display_name"
}

set_layout_and_notify() {
  setxkbmap "$1"
  send_notification "$1"
}

toggle_layout() {
  current_layout=$(get_current_layout)
  if [ "$current_layout" = "$1" ]; then
    set_layout_and_notify "$2"
  else
    set_layout_and_notify "$1"
  fi
}

toggle_international() {
  current_layout=$(get_current_layout)
  case "$current_layout" in
    "$DEFAULT_LAYOUT")
      set_layout_and_notify "$DEFAULT_LAYOUT_INTL"
      ;;
    "$DEFAULT_LAYOUT_INTL")
      set_layout_and_notify "$DEFAULT_LAYOUT"
      ;;
    "$DEFAULT_DVORAK_LAYOUT")
      set_layout_and_notify "$DEFAULT_DVORAK_LAYOUT_INTL"
      ;;
    "$DEFAULT_DVORAK_LAYOUT_INTL")
      set_layout_and_notify "$DEFAULT_DVORAK_LAYOUT"
      ;;
    *)
      set_layout_and_notify "$DEFAULT_LAYOUT"
      ;;
  esac
}

main() {
  if [ "$1" = "x" ]; then
    toggle_layout "$DEFAULT_LAYOUT" "$DEFAULT_DVORAK_LAYOUT"
  else
    toggle_international
  fi
}

main "$@"
