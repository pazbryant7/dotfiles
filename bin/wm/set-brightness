#!/bin/env sh

OUTPUT="HDMI-2"

prompt_brightness() {
  rofi -dmenu \
    -p "Brightness (1-7 shortcut or value like 1.2):" \
    -lines 1
}

normalize_brightness() {
  brightness="$1"

  case "$brightness" in
  1) brightness="1.00" ;;
  2) brightness="0.80" ;;
  3) brightness="0.60" ;;
  4) brightness="0.40" ;;
  5) brightness="0.30" ;;
  6) brightness="0.20" ;;
  7) brightness="0.10" ;;
  esac

  awk -v value="$brightness" '
    BEGIN {
      if (value ~ /^[0-9]+([.][0-9]+)?$/ && value > 0) {
        print value
        exit 0
      }

      exit 1
    }
  '
}

get_current_gamma() {
  gamma="$(xrandr --verbose |
    awk -v output="$OUTPUT" '
      $1 == output { found = 1 }
      found && /Gamma:/ {
        print $2
        exit
      }
    ')"

  case "$gamma" in
  1.0:1.2:1.5 | 1:1.2:1.5)
    printf '%s\n' "1.0:1.2:1.5"
    ;;
  *)
    printf '%s\n' "1.0:1.0:1.0"
    ;;
  esac
}

apply_brightness() {
  brightness="$1"
  gamma="$2"

  xrandr \
    --output "$OUTPUT" \
    --brightness "$brightness" \
    --gamma "$gamma"
}

main() {
  brightness="$(prompt_brightness)"
  [ -z "$brightness" ] && exit 0

  brightness="$(normalize_brightness "$brightness")" || {
    printf '%s\n' "Brightness must be a positive number." >&2
    exit 1
  }

  gamma="$(get_current_gamma)"
  apply_brightness "$brightness" "$gamma"
}

main "$@"
