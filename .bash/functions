cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/bash"

reload_bash() {
  source "$HOME/.bashrc"
}

cache_init() {
  local name="$1" cache_file command_path temp_file
  shift

  command_path="$(command -v "$name")" || return 0
  cache_file="$cache_dir/$name.bash"
  (umask 077 && mkdir -p "$cache_dir") || return 1
  chmod 700 "$cache_dir" || return 1

  if [ ! -s "$cache_file" ] || [ "$command_path" -nt "$cache_file" ]; then
    temp_file="$(umask 077 && mktemp "$cache_dir/$name.XXXXXX")" || return 1
    if ! "$@" >"$temp_file"; then
      rm -f "$temp_file"
      return 1
    fi
    mv -f "$temp_file" "$cache_file" || {
      rm -f "$temp_file"
      return 1
    }
  fi

  source "$cache_file"
}

load_fzf() {
  [ -n "${fzf_loaded:-}" ] && return 0
  cache_init fzf fzf --bash || return 1
  # fzf binds Ctrl-R too; restore Atuin's history widget after loading it.
  if [ "${__atuin_bind_ctrl_r:-false}" = true ]; then
    atuin-bind -m emacs '\C-r' atuin-search-emacs
    atuin-bind -m vi-insert '\C-r' atuin-search-viins
    atuin-bind -m vi-command '/' atuin-search-emacs
  fi
  fzf_loaded=1
}

fzf_file_widget() {
  load_fzf || return
  fzf-file-widget
}
