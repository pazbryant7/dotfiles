BASH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/bash"

reload_bash() {
  source "$HOME/.bashrc"
}

bash_cache_init() {
  local name="$1" cache_file command_path temp_file
  shift

  command_path="$(command -v "$name")" || return 0
  cache_file="$BASH_CACHE_DIR/$name.bash"
  (umask 077 && mkdir -p "$BASH_CACHE_DIR") || return 1
  chmod 700 "$BASH_CACHE_DIR" || return 1

  if [ ! -s "$cache_file" ] || [ "$command_path" -nt "$cache_file" ]; then
    temp_file="$(umask 077 && mktemp "$BASH_CACHE_DIR/$name.XXXXXX")" || return 1
    if ! "$@" >"$temp_file"; then
      rm -f "$temp_file"
      return 1
    fi
    mv -f "$temp_file" "$cache_file" || {
      rm -f "$temp_file"
      return 1
    }
  fi

  source "$cache_file"
}

bash_load_fzf() {
  [ -n "${BASH_FZF_LOADED:-}" ] && return 0
  bash_cache_init fzf fzf --bash || return 1
  # fzf binds Ctrl-R too; restore Atuin's history widget after loading it.
  if [ "${__atuin_bind_ctrl_r:-false}" = true ]; then
    atuin-bind -m emacs '\C-r' atuin-search-emacs
    atuin-bind -m vi-insert '\C-r' atuin-search-viins
    atuin-bind -m vi-command '/' atuin-search-emacs
  fi
  BASH_FZF_LOADED=1
}

bash_fzf_file_widget() {
  bash_load_fzf || return
  fzf-file-widget
}
