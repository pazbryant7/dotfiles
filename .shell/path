__shell_add_path() {
  local dir entry prefix="" remaining unique="" seen=":"
  local -a paths=(
    "/usr/local/bin"
    "$HOME/bin/global"
    "$HOME/bin/crontab"
    "$HOME/.nix-profile/bin"
    "$HOME/.local/share/bob/nvim-bin"
    "$HOME/Documents/github/templates/bin"
  )

  for dir in "${paths[@]}"; do
    prefix="${prefix:+$prefix:}$dir"
  done

  PATH="${prefix}${PATH:+:$PATH}"

  # Avoid growing PATH each time an interactive subshell loads this file.
  remaining="$PATH"
  while [ -n "$remaining" ]; do
    case "$remaining" in
    *:*)
      entry=${remaining%%:*}
      remaining=${remaining#*:}
      ;;
    *)
      entry=$remaining
      remaining=
      ;;
    esac

    [ -n "$entry" ] || continue
    case "$seen" in
    *":$entry:"*) ;;
    *)
      seen="${seen}${entry}:"
      unique="${unique:+$unique:}$entry"
      ;;
    esac
  done

  export PATH="$unique"
}

__shell_add_path
unset -f __shell_add_path
